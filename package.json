{
  "name": "react-boilerplate",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "tsc && vite build",
    "serve": "vite preview",
    "set-admin-claim": "node scripts/set-admin-claim.js",
    "commitlint": "commitlint --edit",
    "format": "prettier --ignore-path .prettierignore --ignore-path .gitignore --check \"**/*.+(js|json|ts|tsx)\"",
    "format:fix": "prettier --ignore-path .prettierignore --ignore-path .gitignore --write \"**/*.+(js|json|ts|tsx)\"",
    "lint": "eslint --ext .js,.ts,.tsx ./src --max-warnings=0 --ignore-path .gitignore",
    "lint:fix": "eslint src --max-warnings=0 --fix",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "validate": "npm-run-all --parallel typecheck lint format",
    "validate-and-build": "npm-run-all validate build",
    "deploy": "npm-run-all validate-and-build serve"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@heroicons/react": "2.1.3",
    "@mui/material": "^7.3.5",
    "@mui/x-charts": "^8.17.0",
    "@reduxjs/toolkit": "2.2.3",
    "@tanstack/react-router": "1.27.0",
    "async-mutex": "0.5.0",
    "clsx": "2.1.1",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.7.0",
    "motion": "12.23.22",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-redux": "9.1.1",
    "redux-persist": "6.0.0",
    "tailwind-merge": "2.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "19.2.2",
    "@commitlint/config-conventional": "19.2.2",
    "@tanstack/router-devtools": "1.27.0",
    "@tanstack/router-vite-plugin": "1.26.21",
    "@types/node": "20.12.7",
    "@types/react": "18.2.66",
    "@types/react-dom": "18.2.22",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/parser": "7.2.0",
    "@vitejs/plugin-react-swc": "3.5.0",
    "autoprefixer": "10.4.19",
    "dotenv": "17.2.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "5.1.3",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.6",
    "eslint-plugin-simple-import-sort": "12.1.0",
    "eslint-plugin-tailwindcss": "3.15.1",
    "husky": "9.0.11",
    "npm-run-all": "4.1.5",
    "postcss": "8.4.38",
    "prettier": "3.2.5",
    "tailwindcss": "3.4.3",
    "tailwindcss-touch": "1.0.1",
    "typescript": "5.2.2",
    "vite": "5.2.0"
  }
}
